<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
<plist version="1.0">
<dict>
    <!-- Core App Sandbox Escape Capabilities -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    
    <!-- Mandatory Group Mapping for worse_query Hooking -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.apple.mobilegestalt</string>
        <string>group.com.apple.featureflags</string>
    </array>
    
    <!-- Inter-Process Communication Rights for iOS 27 XPC Daemons -->
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>get-task-allow</key>
    <true/>
</dict>
</plist>
